# Eaststone controlled-document source
# Development/test can use a local directory.
# Production should use the UNC path behind N:\Controlled Documents\Approved Documents\Approved SOPs
EQMS_APPROVED_DOCS_ROOT=N:\Controlled Documents\Approved Documents\Approved SOPs
EQMS_DOCUMENT_REPOSITORY=./controlled_repository

